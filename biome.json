{
  "files": {
    "include": [
      "packages/**",
      "vitest.config.ts"
    ],
    "ignore": [
      "**/dist/**",
      "**/node_modules/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "organizeImports": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}