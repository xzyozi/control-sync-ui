{
  "name": "@csu/demo",
  "version": "0.1.0",
  "private": true,
  "description": "2画面（対象端末・外部PC）動作確認用デモと結合・E2Eテスト",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@csu/core": "file:../core",
    "@csu/relay": "file:../relay",
    "@csu/storage-indexeddb": "file:../storage-indexeddb",
    "@csu/transport-http": "file:../transport-http"
  }
}
